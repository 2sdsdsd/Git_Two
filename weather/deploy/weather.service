[Unit]
Description=Xiaoliu Weather Website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=weather
Group=weather
WorkingDirectory=/opt/weather
ExecStart=/usr/bin/node /opt/weather/server/server.cjs --no-browser --port 8787
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
